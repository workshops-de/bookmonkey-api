{
  "name": "bookmonkey-api",
  "description": "A simple backend for the BookMonkey example application.",
  "version": "3.2.0",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compose-middleware": "^5.0.1",
    "express-conditional-middleware": "^2.1.1",
    "express-validator": "^7.3.2",
    "json-server": "^0.17.4",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "bin": {
    "bookmonkey-api": "server.js"
  },
  "scripts": {
    "start": "node server",
    "prepublishOnly": "npm test",
    "version": "git add -A",
    "postversion": "git push && git push --tags",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workshops-de/bookmonkey-api.git"
  },
  "keywords": [
    "api",
    "books",
    "demo",
    "json-server",
    "workshop"
  ],
  "author": "workshops.de",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/workshops-de/bookmonkey-api/issues"
  },
  "homepage": "https://github.com/workshops-de/bookmonkey-api#readme",
  "files": [
    "server.js",
    "users.js",
    "getBooks.js",
    "constants.js",
    "db.json",
    "db-original.json",
    "banner.txt",
    "middlewares/",
    "public/",
    "vendor/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
