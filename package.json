{
  "name": "bookmonkey-api",
  "version": "4.0.0",
  "description": "A simple backend for the BookMonkey example application.",
  "author": "workshops.de",
  "license": "MIT",
  "bin": {
    "bookmonkey-api": "bin/bookmonkey-api.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist/",
    "bin/"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "express": "^5.0.0",
    "morgan": "^1.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workshops-de/bookmonkey-api.git"
  },
  "bugs": {
    "url": "https://github.com/workshops-de/bookmonkey-api/issues"
  },
  "homepage": "https://github.com/workshops-de/bookmonkey-api#readme",
  "keywords": [
    "api",
    "books",
    "demo",
    "workshop"
  ]
}
